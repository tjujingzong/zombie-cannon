#!/usr/bin/env bash
# post-commit: 调用 opencode 把本次提交摘要追加到 docs/迭代记录.md
#
# - 提交已完成，本钩子失败不影响提交（post-commit 退出码被 git 忽略）
# - 跳过单次记录：OPENCODE_ITERATION_SKIP=1 git commit
# - 未安装 opencode 时静默跳过
# - 激活方式：git config core.hooksPath githooks
set -u

[ -n "${OPENCODE_ITERATION_SKIP:-}" ] && exit 0
command -v opencode >/dev/null 2>&1 || { echo "ℹ️ 未找到 opencode，跳过迭代记录"; exit 0; }

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO" || exit 0

# 收集本次提交元数据（控制长度，避免命令行超限）
HASH="$(git rev-parse --short HEAD)"
SUBJECT="$(git log -1 --pretty=%s)"
AUTHOR="$(git log -1 --pretty=%an)"
DATE="$(git log -1 --pretty=%ad --date=format:'%Y-%m-%d %H:%M')"
FILES="$(git diff-tree --no-commit-id --name-only -r HEAD | head -30 | tr '\n' ' ')"
NFILES="$(git diff-tree --no-commit-id --name-only -r HEAD | wc -l | tr -d ' ')"
STAT="$(git show --stat --format= HEAD | head -40 | sed '/^$/d')"
[ "$NFILES" -gt 30 ] && FILES="$FILES …（共 $NFILES 个文件）"

echo "📝 生成迭代记录（opencode）……"

PROMPT="你是项目迭代记录助手。基于下面提交信息，在文件 docs/迭代记录.md 末尾追加一条记录。
规则：只在末尾追加一条，绝不修改或删除已有内容。严格用如下 markdown 格式：

## ${HASH} ${SUBJECT}

- **时间**：${DATE}
- **作者**：${AUTHOR}
- **变更文件**：${FILES}

**变更摘要**
（2~4 句概括本次改动，基于提交标题与 diff）

**影响范围**
（受影响的模块/系统，顿号分隔）

---

参考信息：
- 提交标题：${SUBJECT}
- diff --stat：
${STAT}"

opencode run --auto "$PROMPT" >/dev/null 2>&1 \
  && echo "✅ docs/迭代记录.md 已更新" \
  || echo "⚠️ 迭代记录生成失败（不影响提交）"

exit 0
